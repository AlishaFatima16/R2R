# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose and the pipeline)
POSTGRES_USER=r2r
POSTGRES_PASSWORD=change_me
POSTGRES_DB=r2r
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://r2r:change_me@localhost:5432/r2r

# Sent in the User-Agent header so API owners can contact us
CONTACT_EMAIL=your_email_here

# Optional: only if we add the GitHub API later
GITHUB_TOKEN=

# Where raw API responses are stored locally (ignored by Git)
RAW_DATA_DIR=data/raw
